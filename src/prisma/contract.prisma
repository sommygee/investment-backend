// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model InvestmentPlan {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Float
  return    Float
  duration  Int
  createdAt TimestamptzString @default(now())
}